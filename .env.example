# CS Career Intelligence Platform - Environment Configuration

# Flask Backend
FLASK_APP=backend.app
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-in-production-to-a-secure-random-secret

# Database (MySQL)
DATABASE_URL=mysql+pymysql://career_user:career_password@127.0.0.1:3306/career_intelligence
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=career_user
MYSQL_PASSWORD=career_password
MYSQL_DATABASE=career_intelligence

# LLM Provider (Google Gemini API via LangChain)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Job Data Providers
# Primary MVP Provider: Adzuna (Sign up at https://developer.adzuna.com/)
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here

# Optional Secondary Providers
REED_API_KEY=your_reed_api_key_here
JOOBLE_API_KEY=your_jooble_api_key_here

# Frontend & CORS
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
